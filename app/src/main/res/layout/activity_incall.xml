<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/incallRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_main">

    <com.vibe.dialer.DynamicCallBackgroundView
        android:id="@+id/dynamicBg"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/callInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="56dp"
        android:gravity="center"
        android:orientation="vertical">
        <TextView android:id="@+id/callStateText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Вызов" android:textColor="#CCFFFFFF" android:textSize="16sp"/>
        <TextView android:id="@+id/callerText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Неизвестный номер" android:textColor="@color/white" android:textSize="32sp" android:textStyle="bold"/>
    </LinearLayout>

    <!-- Compact Orbit strip -->
    <LinearLayout
        android:id="@+id/orbitStrip"
        android:layout_width="52dp"
        android:layout_height="160dp"
        android:layout_gravity="center_vertical|end"
        android:layout_marginEnd="8dp"
        android:background="@drawable/bg_glass_panel"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="6dp"
        android:visibility="gone">
        <View android:layout_width="24dp" android:layout_height="4dp" android:background="#88FFFFFF"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="|||" android:textColor="@color/white" android:textSize="18sp"/>
    </LinearLayout>

    <!-- Main controls panel -->
    <LinearLayout
        android:id="@+id/inCallControls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="56dp"
        android:background="@drawable/bg_glass_panel"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout android:id="@+id/quickRow" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center">
            <ImageButton android:id="@+id/muteBtn" android:layout_width="60dp" android:layout_height="60dp" android:background="@drawable/bg_glass_button" android:src="@android:drawable/ic_lock_silent_mode" android:tint="@color/white"/>
            <ImageButton android:id="@+id/speakerBtn" android:layout_width="60dp" android:layout_height="60dp" android:layout_marginStart="12dp" android:background="@drawable/bg_glass_button" android:src="@android:drawable/ic_lock_silent_mode_off" android:tint="@color/white"/>
            <ImageButton android:id="@+id/holdBtn" android:layout_width="60dp" android:layout_height="60dp" android:layout_marginStart="12dp" android:background="@drawable/bg_glass_button" android:src="@android:drawable/ic_media_pause" android:tint="@color/white"/>
        </LinearLayout>

        <LinearLayout android:id="@+id/extraRow" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="horizontal" android:gravity="center" android:visibility="gone">
            <ImageButton android:id="@+id/addCallBtn" android:layout_width="56dp" android:layout_height="56dp" android:background="@drawable/bg_glass_button" android:src="@android:drawable/ic_input_add" android:tint="@color/white"/>
            <ImageButton android:id="@+id/dialNewBtn" android:layout_width="56dp" android:layout_height="56dp" android:layout_marginStart="12dp" android:background="@drawable/bg_glass_button" android:src="@android:drawable/ic_dialog_dialer" android:tint="@color/white"/>
            <ImageButton android:id="@+id/recordBtn" android:layout_width="56dp" android:layout_height="56dp" android:layout_marginStart="12dp" android:background="@drawable/bg_glass_button" android:src="@android:drawable/ic_btn_speak_now" android:tint="@color/white"/>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:gravity="center" android:orientation="horizontal">
            <ImageButton android:id="@+id/expandBtn" android:layout_width="48dp" android:layout_height="48dp" android:background="@drawable/bg_glass_button" android:src="@android:drawable/arrow_down_float" android:tint="@color/white"/>
            <ImageButton android:id="@+id/answerBtn" android:layout_width="72dp" android:layout_height="72dp" android:layout_marginStart="16dp" android:background="@drawable/bg_call" android:src="@android:drawable/ic_menu_call" android:tint="@color/white" android:visibility="gone"/>
            <ImageButton android:id="@+id/hangupBtn" android:layout_width="72dp" android:layout_height="72dp" android:layout_marginStart="16dp" android:background="@drawable/bg_hangup" android:src="@android:drawable/ic_menu_close_clear_cancel" android:tint="@color/white"/>
        </LinearLayout>
    </LinearLayout>
    <!-- Google style swipe -->
    <FrameLayout android:id="@+id/googleSwipe" android:layout_width="280dp" android:layout_height="72dp" android:layout_gravity="bottom|center_horizontal" android:layout_marginBottom="60dp" android:background="@drawable/bg_glass_panel" android:visibility="gone">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_vertical|start" android:layout_marginStart="20dp" android:text="Отклонить" android:textColor="#FFFF5A6A"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_vertical|end" android:layout_marginEnd="20dp" android:text="Ответить" android:textColor="#FF4CD964"/>
        <ImageButton android:id="@+id/swipeKnob" android:layout_width="60dp" android:layout_height="60dp" android:layout_gravity="center" android:background="@drawable/bg_call" android:src="@android:drawable/ic_menu_call" android:tint="@color/white"/>
    </FrameLayout>

    <!-- Xiaomi incoming -->
    <LinearLayout android:id="@+id/xiaomiIncoming" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom|center_horizontal" android:layout_marginBottom="60dp" android:gravity="center" android:orientation="horizontal" android:visibility="gone">
        <ImageButton android:id="@+id/xiaomiDecline" android:layout_width="76dp" android:layout_height="76dp" android:background="@drawable/bg_hangup" android:src="@android:drawable/ic_menu_close_clear_cancel" android:tint="@color/white"/>
        <ImageButton android:id="@+id/xiaomiAnswer" android:layout_width="76dp" android:layout_height="76dp" android:layout_marginStart="64dp" android:background="@drawable/bg_call" android:src="@android:drawable/ic_menu_call" android:tint="@color/white"/>
    </LinearLayout>

    <ImageButton android:id="@+id/minimizeBtn" android:layout_width="44dp" android:layout_height="44dp" android:layout_gravity="top|start" android:layout_marginStart="16dp" android:layout_marginTop="64dp" android:background="@drawable/bg_glass_button" android:src="@android:drawable/arrow_down_float" android:tint="@color/white"/>

    <LinearLayout android:id="@+id/shieldBox" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="top|end" android:layout_marginEnd="16dp" android:layout_marginTop="64dp" android:background="@drawable/bg_glass_panel" android:gravity="center" android:orientation="horizontal" android:padding="8dp">
        <ProgressBar android:id="@+id/shieldSpin" style="?android:attr/progressBarStyleSmall" android:layout_width="18dp" android:layout_height="18dp"/>
        <TextView android:id="@+id/shieldIcon" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🛡" android:textSize="16sp"/>
        <TextView android:id="@+id/shieldCode" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:textColor="@color/white" android:textSize="12sp" android:visibility="gone"/>
    </LinearLayout>

    <TextView android:id="@+id/recordBadge" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="bottom|center_horizontal" android:layout_marginBottom="16dp" android:background="@drawable/bg_glass_panel" android:padding="10dp" android:text="Запись..." android:textColor="#FFFF5A6A" android:visibility="gone"/>

    <LinearLayout android:id="@+id/endStatusOverlay" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#AA000000" android:gravity="center" android:orientation="vertical" android:visibility="gone">
        <TextView android:id="@+id/endStatusText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/white" android:textSize="28sp" android:textStyle="bold"/>
        <Button android:id="@+id/endCloseBtn" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="Закрыть"/>
    </LinearLayout>

</FrameLayout>
