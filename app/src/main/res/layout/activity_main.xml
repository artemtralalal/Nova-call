<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_main">

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/titleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Телефон"
            android:textColor="@color/white"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/subtitleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Vibe Dialer"
            android:textColor="#99FFFFFF"
            android:textSize="14sp" />

        <FrameLayout
            android:id="@+id/pageContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="12dp">

            <LinearLayout
                android:id="@+id/pagePhone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="top">

                <TextView
                    android:id="@+id/numberText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:minHeight="56dp"
                    android:padding="8dp"
                    android:textColor="@color/white"
                    android:textSize="34sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/defaultDialerHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_glass_panel"
                    android:padding="14dp"
                    android:text="Нажмите, чтобы сделать Vibe Dialer звонилкой по умолчанию"
                    android:textColor="@color/white"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/pageContacts"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:visibility="gone">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Контакты будут здесь. Разрешите доступ к контактам в настройках системы."
                    android:textColor="#CCFFFFFF"
                    android:textSize="15sp"
                    android:background="@drawable/bg_glass_panel"
                    android:padding="16dp"/>
            </LinearLayout>

            <ScrollView
                android:id="@+id/pageSettings"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/rightHandSwitch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Режим правой руки (Orbit)"
                        android:textColor="@color/white" />
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/hapticSwitch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Виброотклик"
                        android:textColor="@color/white" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Прозрачность стекла" android:textColor="#CCFFFFFF" android:layout_marginTop="12dp"/>
                    <SeekBar android:id="@+id/glassSeek" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="100"/>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Размер кнопок" android:textColor="#CCFFFFFF" android:layout_marginTop="12dp"/>
                    <SeekBar android:id="@+id/scaleSeek" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="70"/>
                    <Button
                        android:id="@+id/requestDefaultBtn"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Сделать звонилкой по умолчанию" />
                </LinearLayout>
            </ScrollView>
        </FrameLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/floatingKeypad"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_margin="16dp"
        android:layout_marginBottom="96dp"
        android:background="@drawable/bg_glass_panel"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Клавиатура"
                android:textColor="#CCFFFFFF" />
            <ImageButton
                android:id="@+id/hideKeypadBtn"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_glass_button"
                android:src="@android:drawable/arrow_down_float"
                android:tint="@color/white" />
        </LinearLayout>

        <GridLayout
            android:id="@+id/keypadGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:columnCount="3"
            android:rowCount="4"
            android:useDefaultMargins="true" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center">
            <ImageButton
                android:id="@+id/backspaceBtn"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/bg_glass_button"
                android:src="@android:drawable/ic_input_delete"
                android:tint="@color/white" />
            <ImageButton
                android:id="@+id/callBtn"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                android:background="@drawable/bg_call"
                android:src="@android:drawable/ic_menu_call"
                android:tint="@color/white" />
            <View android:layout_width="64dp" android:layout_height="64dp" />
        </LinearLayout>
    </LinearLayout>

    <ImageButton
        android:id="@+id/showKeypadBtn"
        android:layout_width="62dp"
        android:layout_height="62dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="100dp"
        android:background="@drawable/bg_glass_panel"
        android:src="@android:drawable/ic_dialog_dialer"
        android:tint="@color/white"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_margin="16dp"
        android:background="@drawable/bg_nav"
        android:padding="6dp">

        <View
            android:id="@+id/navBubble"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:background="@drawable/bg_nav_bubble" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">
            <TextView android:id="@+id/navContacts" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="Контакты" android:textColor="@color/white" android:textStyle="bold"/>
            <TextView android:id="@+id/navPhone" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="Телефон" android:textColor="@color/white" android:textStyle="bold"/>
            <TextView android:id="@+id/navSettings" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="Настройки" android:textColor="@color/white" android:textStyle="bold"/>
        </LinearLayout>
    </FrameLayout>

</FrameLayout>
